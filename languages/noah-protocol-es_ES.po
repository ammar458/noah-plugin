msgid "Payment Methods"
msgstr "Métodos de Pago"

msgid "View and manage your saved payment methods"
msgstr "Consulta y gestiona tus métodos de pago guardados"

msgid "My Membership"
msgstr "Mi Membresía"

msgid "View your membership status and programs"
msgstr "Consulta el estado de tu membresía y tus programas"

msgid "Become a member for exclusive pricing"
msgstr "Hazte miembro y obtén precios exclusivos"

msgid "Account Details"
msgstr "Detalles de la Cuenta"

msgid "Edit your password and account information"
msgstr "Edita tu contraseña e información de la cuenta"
